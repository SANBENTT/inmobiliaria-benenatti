@model IEnumerable<inmobiliaria_benenatti.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between mb-3">
        <a href="@Url.Action("Edicion")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Tipo de Inmueble
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripcion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipo in Model)
                {
                    <tr>
                        <td>@tipo.IdTipoInmueble</td>
                        <td>@tipo.Nombre</td>
                        <td>@(tipo.Descripcion ?? "Sin descripcion")</td>
                        <td>
                            <a href="@Url.Action("Detalles", new { id = tipo.IdTipoInmueble })" 
                               class="btn btn-info btn-sm" title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edicion", new { id = tipo.IdTipoInmueble })" 
                               class="btn btn-warning btn-sm" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a href="@Url.Action("Eliminar", new { id = tipo.IdTipoInmueble })" 
                                   class="btn btn-danger btn-sm" title="Eliminar"
                                   onclick="return confirm('¿Estas seguro de eliminar este tipo de inmueble?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>