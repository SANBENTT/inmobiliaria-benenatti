@model inmobiliaria_benenatti.Models.TipoInmueble

@{
    ViewData["Title"] = Model.IdTipoInmueble == 0 ? "Crear Tipo de Inmueble" : "Editar Tipo de Inmueble";
}

<h4>@(Model.IdTipoInmueble == 0 ? "Crear Tipo de Inmueble" : "Editar Tipo de Inmueble")</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Guardar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdTipoInmueble" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> @(Model.IdTipoInmueble == 0 ? "Crear" : "Guardar")
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al Listado
                </a>
            </div>
        </form>
    </div>
    
    <div class="col-md-6">
        <div class="alert alert-info">
            <h6><i class="fas fa-info-circle"></i> Informacion</h6>
            <p class="mb-0">Los tipos de inmueble se utilizan para clasificar las propiedades (Casa, Departamento, Local, etc.).</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}