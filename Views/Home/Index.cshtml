@using System.Security.Claims
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">@ViewBag.Mensaje</h1>
    
    @if (User.Identity.IsAuthenticated)
    {
        <div class="alert alert-success mt-4">
            <h4>✅ Has iniciado sesion correctamente</h4>
            <p>Nombre: @User.FindFirst("FullName")?.Value</p>
            <p>Email: @User.Identity.Name</p>
            <p>Rol: @User.FindFirst(ClaimTypes.Role)?.Value</p>
        </div>
        
        <div class="mt-3">
            <a href="@Url.Action("Perfil", "Usuarios")" class="btn btn-primary">Ver Mi Perfil</a>
            <a href="@Url.Action("Index", "Inmuebles")" class="btn btn-success">Ver Inmuebles</a>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <h4>🔐 Inicia sesión para acceder al sistema</h4>
            <a href="@Url.Action("Login", "Usuarios")" class="btn btn-primary">Iniciar Sesión</a>
        </div>
    }
</div>
