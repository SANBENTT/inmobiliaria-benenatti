@model inmobiliaria_benenatti.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" class="img-fluid rounded-circle mb-3" alt="Avatar" style="width: 150px; height: 150px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 150px; height: 150px;">
                        <span class="text-white display-4">@Model.Nombre[0]</span>
                    </div>
                }
                
                <h4>@Model.Nombre</h4>
                <p class="text-muted">@Model.Email</p>
                <span class="badge bg-primary">@Model.RolNombre</span>
                
                <div class="mt-3">
                    <a href="@Url.Action("EditarPerfil")" class="btn btn-primary btn-sm">Editar Perfil</a>
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <form asp-action="EliminarAvatar" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar avatar?')">Eliminar Avatar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Informacion del Perfil</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID Usuario:</dt>
                    <dd class="col-sm-9">@Model.IdUsuario</dd>
                    
                    <dt class="col-sm-3">Email:</dt>
                    <dd class="col-sm-9">@Model.Email</dd>
                    
                    <dt class="col-sm-3">Nombre:</dt>
                    <dd class="col-sm-9">@Model.Nombre</dd>
                    
                    <dt class="col-sm-3">Rol:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-primary">@Model.RolNombre</span>
                    </dd>
                    
                    <dt class="col-sm-3">Miembro desde:</dt>
                    <dd class="col-sm-9">@Model.CreadoEn.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}