@model inmobiliaria_benenatti.Models.LoginView
@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar Sesion</h2>

<form asp-action="Login" method="post">
    <div class="form-group">
        <label asp-for="Usuario" class="control-label">Email</label>
        <input asp-for="Usuario" class="form-control" type="email" />
        <span asp-validation-for="Usuario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Clave" class="control-label">Contraseña</label>
        <input asp-for="Clave" class="form-control" type="password" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Ingresar</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-2">@ViewBag.Error</div>
}