@model IEnumerable<inmobiliaria_benenatti.Models.Inquilinos>

@{
    ViewData["Title"] = "Lista de Inquilinos";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Edicion")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Inquilino
        </a>
    </div>


    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th>    
                @Html.DisplayNameFor(model => model.dni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.telefono)
            </th>
             <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
             <th>
                @Html.DisplayNameFor(model => model.direccion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) 
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.nombre)
                </td>
                 <td>
                    @Html.DisplayFor(modelItem => item.dni)
                </td>
                 <td>
                    @Html.DisplayFor(modelItem => item.telefono)
                </td>
                 <td>
                    @Html.DisplayFor(modelItem => item.email)
                 </td>
                 <td>
                     @Html.DisplayFor(modelItem => item.direccion)
                 </td>
                <td>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("Detalles", new { id = item.id})" 
                        class="btn btn-sm btn-info" title="Detalles">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Edicion", new { id = item.id})" 
                        class="btn btn-sm btn-warning" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="@Url.Action("Eliminar", new { id = item.id })" 
                            class="btn btn-sm btn-danger" title="Eliminar"
                            onclick="return confirm('¿Está seguro que desea eliminar este registro?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="Solo administradores pueden eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </div>
                 </td>
            </tr>    
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function Eliminar(id, nombre){
         if (confirm(`¿Confirma la baja del inquilino ${nombre} ?`)) {
            location.href = "/Inquilinos/Eliminar/" + id;
        }
    }
    </script>
}