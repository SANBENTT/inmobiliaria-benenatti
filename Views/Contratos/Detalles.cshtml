@model inmobiliaria_benenatti.Models.Contrato

@{
    ViewData["Title"] = "Listado de Contratos";
    int id = Model==null ? 0 : Model.IdContrato;
    }

<h4>Detalles del Contratos</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.IdContrato)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.IdContrato)
                    </dd>

                    <dt class="col-sm-4">Inquilino</dt>
                    <dd class="col-sm-8">@Model?.Inquilino?.nombre</dd>

                    <dt class="col-sm-4">Inmueble</dt>
                    <dd class="col-sm-8">@Model?.Inmueble?.Direccion</dd>
                    </dd>

                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.FechaInicio)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.FechaInicio)
                    </dd>

                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.FechaFin)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.FechaFin)
                    </dd>

                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Monto)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Monto)
                    </dd>
                </dl>
            </div>
        </div>

        <div class="form-group mt-3">
            <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
        </div>
    </div>
</div>

