@model IEnumerable<inmobiliaria_benenatti.Models.Contrato>

@{
    ViewData["Title"] = "Lista de Contratos";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Edicion")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Contrato
        </a>
    </div>


    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">


        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdContrato)
            </th>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Monto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) 
        {
            <tr>
                <td>
                   @Html.DisplayFor(modelItem => item.IdContrato)
                </td>
                <td>@item.Inquilino?.nombre</td>
                <td>@item.Inmueble?.Direccion</td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaInicio)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaFin)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Monto)
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("Detalles", new { id = item.IdContrato })" 
                        class="btn btn-sm btn-info" title="Detalles">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Edicion", new { id = item.IdContrato })" 
                        class="btn btn-sm btn-warning" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                        
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="@Url.Action("Eliminar", new { id = item.IdContrato })" 
                            class="btn btn-sm btn-danger" title="Eliminar"
                            onclick="return confirm('¿Ests seguro que deseas eliminar este registro?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="Solo administradores pueden eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </div>
                 </td>
            </tr>    
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function Eliminar(IdContrato, descripcion){
            if (confirm(`¿Confirma la baja del ${descripcion}?`)) {
                location.href = "/Contratos/Eliminar/" + IdContrato;
            }
        }
    </script>
}

