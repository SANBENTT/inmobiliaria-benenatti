@model IEnumerable<inmobiliaria_benenatti.Models.Pago>

@{
    ViewData["Title"] = "Lista de Pagos";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Edicion")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Pago
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Contrato</th>
                    <th>Fecha de Pago</th>
                    <th>Monto</th>
                    <th>Observacion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPago</td>
                        <td>
                            @if (item.Contrato != null)
                            {
                                <small>@item.Contrato.DisplayInfo</small>
                            }
                            else
                            {
                                <span class="text-muted">Contrato #@item.ContratoId</span>
                            }
                        </td>
                        <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>$@item.Monto.ToString("N2")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Observacion))
                            {
                                <span title="@item.Observacion">
                                    @(item.Observacion.Length > 30 ? item.Observacion.Substring(0, 30) + "..." : item.Observacion)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Sin observacion</span>
                            }
                        </td>
                <td>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("Detalles", new { id = item.IdPago })" 
                        class="btn btn-sm btn-info" title="Detalles">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Edicion", new { id = item.IdPago })" 
                        class="btn btn-sm btn-warning" title="Editar">
                            <i class="fas fa-edit"></i>
                        </a>
                    
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="@Url.Action("Eliminar", new { id = item.IdPago })" 
                            class="btn btn-sm btn-danger" title="Eliminar"
                            onclick="return confirm('¿Está seguro que desea eliminar este registro?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled title="Solo administradores pueden eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </div>
                 </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> No hay pagos registrados
        </div>
    }
</div>