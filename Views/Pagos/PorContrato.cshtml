@model IEnumerable<inmobiliaria_benenatti.Models.Pago>
@{
    ViewData["Title"] = "Pagos del Contrato";
    var contrato = ViewBag.Contrato as inmobiliaria_benenatti.Models.Contrato;
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (contrato != null)
    {
        <div class="alert alert-info">
            <h5>Informacion del Contrato</h5>
            <p class="mb-1"><strong>Contrato:</strong> @contrato.DisplayInfo</p>
            <p class="mb-1"><strong>Monto Mensual:</strong> $@contrato.Monto.ToString("N2")</p>
            <p class="mb-0"><strong>Periodo:</strong> @contrato.FechaInicio.ToString("dd/MM/yyyy") al @contrato.FechaFin.ToString("dd/MM/yyyy")</p>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Edicion")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Pago para este Contrato
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a todos los pagos
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID Pago</th>
                    <th>Fecha de Pago</th>
                    <th>Monto</th>
                    <th>Observación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPago</td>
                        <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>$@item.Monto.ToString("N2")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Observacion))
                            {
                                <span title="@item.Observacion">
                                    @(item.Observacion.Length > 30 ? item.Observacion.Substring(0, 30) + "..." : item.Observacion)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Sin observacion</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("Detalles", new { id = item.IdPago })" 
                                   class="btn btn-sm btn-info" title="Detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edicion", new { id = item.IdPago })" 
                                   class="btn btn-sm btn-warning" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            <i class="fas fa-exclamation-triangle"></i> No hay pagos registrados para este contrato
        </div>
    }

    @if (Model.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Resumen de Pagos</h5>
            </div>
            <div class="card-body">
                @{
                    var totalPagado = Model.Sum(p => p.Monto);
                    var cantidadPagos = Model.Count();
                }
                <dl class="row">
                    <dt class="col-sm-3">Total Pagado:</dt>
                    <dd class="col-sm-9"><strong>$@totalPagado.ToString("N2")</strong></dd>
                    
                    <dt class="col-sm-3">Cantidad de Pagos:</dt>
                    <dd class="col-sm-9">@cantidadPagos</dd>
                    
                    @if (contrato != null)
                    {
                        <dt class="col-sm-3">Monto Mensual Contrato:</dt>
                        <dd class="col-sm-9">$@contrato.Monto.ToString("N2")</dd>
                    }
                </dl>
            </div>
        </div>
    }
</div>