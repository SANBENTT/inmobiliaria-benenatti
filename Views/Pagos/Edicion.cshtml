@model inmobiliaria_benenatti.Models.Pago

@{
    ViewData["Title"] = Model.IdPago == 0 ? "Nuevo Pago" : "Editar Pago";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Guardar" method="post">
        @Html.AntiForgeryToken()
        
        <input type="hidden" asp-for="IdPago" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ContratoId" class="form-label">Contrato *</label>
                    <select asp-for="ContratoId" asp-items="ViewBag.Contratos" class="form-select">
                        <option value="">Seleccione un contrato</option>
                    </select>
                    <span asp-validation-for="ContratoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaPago" class="form-label">Fecha de Pago *</label>
                    <input asp-for="FechaPago" type="date" class="form-control" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Monto" class="form-label">Monto *</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Monto" type="number" step="0.01" min="1" class="form-control" />
                    </div>
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Observacion" class="form-label">Observacion</label>
                    <textarea asp-for="Observacion" class="form-control" rows="5" 
                              placeholder="Observaciones adicionales del pago..."></textarea>
                    <span asp-validation-for="Observacion" class="text-danger"></span>
                    <div class="form-text">Maximo 500 caracteres</div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="@Url.Action("Index")" class="btn btn-secondary me-md-2">
                        <i class="fas fa-arrow-left"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> @(Model.IdPago == 0 ? "Crear Pago" : "Actualizar Pago")
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var fechaPago = document.getElementById('FechaPago');
            if (fechaPago && !fechaPago.value) {
                var today = new Date().toISOString().split('T')[0];
                fechaPago.value = today;
            }
        });
    </script>
}