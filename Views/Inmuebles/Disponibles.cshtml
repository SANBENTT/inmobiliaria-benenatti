@model IEnumerable<inmobiliaria_benenatti.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles Disponibles";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="d-flex justify-content-between mb-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a Todos los Inmuebles
        </a>
        <a href="@Url.Action("DisponiblesPorFecha")" class="btn btn-info">
            <i class="fas fa-calendar"></i> Buscar por Fechas
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Direccion</th>
                    <th>Tipo</th>
                    <th>Uso</th>
                    <th>Ambientes</th>
                    <th>Superficie</th>
                    <th>Propietario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inmueble in Model)
                {
                    <tr>
                        <td>@inmueble.IdInmueble</td>
                        <td>@inmueble.Direccion</td>
                        <td>@(inmueble.TipoInmueble?.Nombre ?? "N/A")</td>
                        <td>@inmueble.UsoNombre</td>
                        <td>@inmueble.Ambientes</td>
                        <td>@inmueble.Superficie.ToString("N2") m²</td>
                        <td>@inmueble.Propietario?.nombre</td>
                        <td>
                            <a href="@Url.Action("Detalles", new { id = inmueble.IdInmueble })" 
                               class="btn btn-info btn-sm" title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edicion", new { id = inmueble.IdInmueble })" 
                               class="btn btn-warning btn-sm" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>