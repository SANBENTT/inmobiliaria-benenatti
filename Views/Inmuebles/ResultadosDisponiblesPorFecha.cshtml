@model IEnumerable<inmobiliaria_benenatti.Models.Inmueble>
@{
    ViewData["Title"] = "Inmuebles Disponibles por Fecha";
}

<div class="container mt-4">
    <h2>Inmuebles Disponibles</h2>
    
    <div class="alert alert-info">
        <strong>Periodo de busqueda:</strong> @ViewBag.FechaInicio.ToString("dd/MM/yyyy") - @ViewBag.FechaFin.ToString("dd/MM/yyyy")
        <br>
        <strong>Resultados encontrados:</strong> @ViewBag.CantidadEncontrados inmuebles
    </div>

    <div class="mb-3">
        <a href="@Url.Action("DisponiblesPorFecha")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Nueva Busqueda
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Direccion</th>
                        <th>Ambientes</th>
                        <th>Superficie</th>
                        <th>Latitud</th>
                        <th>Longitud</th>
                        <th>Propietario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inmueble in Model)
                    {
                        <tr>
                            <td>@inmueble.Direccion</td>
                            <td>@inmueble.Ambientes</td>
                            <td>@inmueble.Superficie m²</td>
                            <td>@inmueble.Latitud</td>
                            <td>@inmueble.Longitud</td>
                            <td>@inmueble.Propietario?.nombre</td>
                            <td>
                                <a href="@Url.Action("Detalles", new { id = inmueble.IdInmueble })" 
                                   class="btn btn-info btn-sm" title="Ver detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edicion", new { id = inmueble.IdInmueble })" 
                                   class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <h4>No se encontraron inmuebles disponibles para el periodo seleccionado</h4>
            <p>Intente ampliar el rango de fechas o modificar los criterios de búsqueda.</p>
        </div>
    }
</div>