@model inmobiliaria_benenatti.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Informacion del Inmueble #@Model.IdInmueble</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Información Principal</h6>
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">@Model.IdInmueble</dd>

                        <dt class="col-sm-4">Direccion:</dt>
                        <dd class="col-sm-8">@Model.Direccion</dd>

                        <dt class="col-sm-4">Ambientes:</dt>
                        <dd class="col-sm-8">@Model.Ambientes</dd>

                        <dt class="col-sm-4">Superficie:</dt>
                        <dd class="col-sm-8">@Model.Superficie.ToString("N2") m²</dd>

                        <dt class="col-sm-4">Propietario:</dt>
                        <dd class="col-sm-8">@Model.Propietario?.nombre</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h6>Información Específica</h6>
                    <dl class="row">
                        <dt class="col-sm-4">Tipo de Inmueble:</dt>
                        <dd class="col-sm-8">@(Model.TipoInmueble?.Nombre ?? "No especificado")</dd>

                        <dt class="col-sm-4">Uso:</dt>
                        <dd class="col-sm-8">@Model.UsoNombre</dd>

                        <dt class="col-sm-4">Coordenadas:</dt>
                        <dd class="col-sm-8">@Model.Latitud.ToString("N6"), @Model.Longitud.ToString("N6")</dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Disponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No disponible</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.TipoInmueble?.Descripcion))
                        {
                            <dt class="col-sm-4">Descripcion del Tipo:</dt>
                            <dd class="col-sm-8">@Model.TipoInmueble.Descripcion</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al Listado
                </a>
                <div>
                    <a href="@Url.Action("Edicion", new { id = Model.IdInmueble })" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a href="@Url.Action("Eliminar", new { id = Model.IdInmueble })" 
                           class="btn btn-danger" 
                           onclick="return confirm('¿Está seguro de eliminar este inmueble?')">
                            <i class="fas fa-trash"></i> Eliminar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>